---
import Layout from '@layouts/Layout.astro';
import { getLangFromUrl, useTranslations } from '@i18n/utils';
import { getProducts } from '@adapters/supabase/products';
import { formatCurrency } from '@core/utils/index';
import { Image } from 'astro:assets';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// L'UI chiama solo l'adapter, non sa nulla di Supabase!
const products = await getProducts();
---

<Layout title="La Bottega">
  <div class="bg-[#F2EFE9] min-h-screen py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      
      <!-- Header Bottega -->
      <div class="text-center mb-16 animate-fade-in-up">
        <h1 class="text-5xl font-bold text-[#2C2A29] mb-4 tracking-tighter">La Bottega</h1>
        <p class="text-lg text-gray-600 font-light max-w-2xl mx-auto">
          Porta a casa un pezzo della nostra storia. Dai vini invecchiati nelle antiche cantine ai prodotti artigianali del territorio.
        </p>
      </div>

      <!-- Griglia Prodotti -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10">
        {products.map((product, index) => (
          <div class={`card bg-white shadow-lg hover:shadow-2xl transition-all duration-300 animate-fade-in-up delay-${(index % 3 + 1) * 100} group`}>
            {product.imageUrl && (
              <figure class="h-64 overflow-hidden relative">
                <Image 
                  src={product.imageUrl} 
                  alt={product.name} 
                  width={600} height={400} format="avif"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" 
                />
                <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-xs font-bold text-[#8C6A4F] uppercase tracking-wider shadow-sm">
                  {product.category}
                </div>
              </figure>
            )}
            <div class="card-body p-8">
              <h2 class="card-title text-2xl font-bold text-[#2C2A29] group-hover:text-[#8C6A4F] transition-colors">{product.name}</h2>
              <p class="text-gray-500 font-light text-sm mb-4 line-clamp-2">{product.description}</p>
              
              <div class="card-actions justify-between items-center mt-auto pt-4 border-t border-gray-100">
                <span class="text-2xl font-light text-[#2C2A29]">
                  {formatCurrency(product.price, lang)}
                </span>
                <button class="btn bg-[#8C6A4F] hover:bg-[#6E533D] text-white border-none rounded-full px-6">
                  Acquista
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>
