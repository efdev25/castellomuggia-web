# Variabili pubbliche accessibili dal client e server
PUBLIC_SUPABASE_URL=https://tuo-progetto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=la-tua-anon-key

# Variabili segrete accessibili SOLO dal server (Astro SSR)
# (Da usare per l'adapter email o per bypassare RLS se strettamente necessario)
SUPABASE_SERVICE_ROLE_KEY=la-tua-service-key
BREVO_API_KEY=la-tua-brevo-key
